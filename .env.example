# docker compose用。このファイルを .env としてコピーして値を埋めてください（.envは.gitignore対象）

# Google Cloud Console で発行したOAuthクライアントの情報
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# セッションCookie署名用の秘密鍵。 openssl rand -hex 32 などで生成した値に必ず変更する
SESSION_SECRET_KEY=

# ログインを許可するメールアドレス（カンマ区切り、小文字）
ALLOWED_EMAILS=you@example.com,teammate@example.com

# 本番は同一オリジン配信のため、公開URLをそのまま指定する
FRONTEND_ORIGIN=http://localhost:8000
BACKEND_BASE_URL=http://localhost:8000
